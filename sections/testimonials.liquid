{%- capture flickity_options -%}{"prevNextButtons":false,"wrapAround":true,"dragThreshold":16,"pageDots":{% if section.blocks.size > 1 %}true{% else %}false{% endif %},"autoPlay":{% if section.settings.autoplay %}{{ section.settings.cycle_speed | times: 1000 }}{% else %}false{% endif %}}{%- endcapture -%}

{%- assign should_show_nav = false -%}

{%- for block in section.blocks -%}
  {%- if block.settings.logo -%}
    {%- assign should_show_nav = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

<section class="Section Section--spacingNormal" id="section-{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="testimonials">
  <div class="TestimonialList {% if should_show_nav %}TestimonialList--withNav{% endif %} Carousel Carousel--fadeIn" data-flickity-config='{{ flickity_options }}'>
    {%- for block in section.blocks -%}
      <div id="block-{{ block.id }}" class="Carousel__Cell Testimonial {% if forloop.first %}is-selected{% endif %}" {{ block.shopify_attributes }} data-slide-index="{{ forloop.index0 }}">
        <div class="Container">
          {%- if block.settings.quote != blank -%}
            <div class="Testimonial__Content">
              {{ block.settings.quote | replace: '<p>', '<p>&ldquo;' | replace: '</p>', '&rdquo;</p>' }}
            </div>
          {%- endif -%}

          {%- if block.settings.author != blank -%}
            <div class="Testimonial__Author">
              - {{ block.settings.author }}
            </div>
          {%- endif -%}

          {%- assign rating = block.settings.rating | default: 5 -%}
          {%- assign rating_int = rating | times: 2 | floor -%}
          {%- assign full_stars = rating_int | divided_by: 2 -%}
          {%- assign remainder = rating_int | modulo: 2 -%}
          {%- assign has_half = false -%}
          {%- if remainder == 1 -%}{%- assign has_half = true -%}{%- endif -%}
          {%- assign empty_stars = 5 | minus: full_stars -%}
          {%- if has_half -%}{%- assign empty_stars = empty_stars | minus: 1 -%}{%- endif -%}

          <div class="Testimonial__Stars" aria-hidden="true">
            {%- for i in (1..full_stars) -%}
              <span class="Testimonial__Star">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
              </span>
            {%- endfor -%}
            {%- if has_half -%}
              <span class="Testimonial__Star Testimonial__Star--half">
                <svg class="Testimonial__StarEmpty" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
                <svg class="Testimonial__StarFull" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
              </span>
            {%- endif -%}
            {%- for i in (1..empty_stars) -%}
              <span class="Testimonial__Star">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
              </span>
            {%- endfor -%}
          </div>

          {%- if block.settings.verified -%}
            <div class="Testimonial__Verified">
              Acquisto verificato
            </div>
          {%- endif -%}

          {%- if block.settings.logo != blank -%}
            <img class="Testimonial__Logo hidden-lap-and-up" src="{{ block.settings.logo | img_url: '300x' }}" width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}" decoding="async" loading="lazy" fetchpriority="low" alt="{{ block.settings.logo.alt | escape }}">
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if should_show_nav -%}
    <div class="TestimonialNav hidden-pocket">
      {%- for block in section.blocks -%}
        {%- if block.settings.logo != blank -%}
          <img class="TestimonialNav__Item {% if forloop.first %}is-selected{% endif %}" src="{{ block.settings.logo | img_url: '300x' }}" width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}" decoding="async" loading="lazy" fetchpriority="low" alt="{{ block.settings.logo.alt | escape }}" data-index="{{ forloop.index0 }}">
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>


{% schema %}
{
  "name": "Recensioni dei Clienti",
  "class": "shopify-section--bordered",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto rotate between testimonials",
      "default": true
    },
    {
      "type": "range",
      "id": "cycle_speed",
      "min": 3,
      "max": 8,
      "step": 1,
      "unit": "sec",
      "label": "Change testimonials every",
      "default": 5
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F9F9F9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Recensione",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "340 x 80px jpg recommended"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Citazione",
          "default": "<p>La raffinatezza di AEQUO risiede nei dettagli. Ogni creazione racconta una storia di eleganza e artigianalità italiana.</p>",
          "info": "Per risultati ottimali, mantieni la lunghezza del testo uniforme tra le recensioni."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Nome cliente",
          "default": "Cliente",
          "info": "es. - Francesco P."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Acquisto verificato",
          "default": true
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 0.5,
          "unit": "★",
          "label": "Valutazione stelle",
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "Text",
      "name": "Recensioni dei Clienti",
      "settings": {},
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "author": "Francesco P.",
            "rating": 4.5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "author": "Sara L."
          }
        },
        {
          "type": "testimonial",
          "settings": {}
        }
      ]
    }
  ]
}
{% endschema %}