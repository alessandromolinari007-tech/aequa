{%- if section.settings.layout_mode == 'carousel' -%}
  {%- capture flickity_options -%}{"prevNextButtons":true,"pageDots":false,"wrapAround":false,"contain":true,"cellAlign":"left","watchCSS":true,"dragThreshold":8,"groupCells":true,"arrowShape":{"x0":20,"x1":60,"y1":40,"x2":60,"y2":35,"x3":25}}{%- endcapture -%}
{%- endif -%}

{%- capture section_settings -%}{"layout":{{ section.settings.layout_mode | json }}}{%- endcapture -%}

<section class="Section Section--spacingNormal{% if section.settings.layout_mode == 'carousel' %} Section--carousel{% else %} Section--grid{% endif %}" data-section-id="{{ section.id }}" data-section-type="featured-collections" data-settings='{{ section_settings }}'>
  <header class="SectionHeader SectionHeader--aligned">

    {%- assign show_tabs = false -%}
    {%- assign first_title = '' -%}
    {%- for block in section.blocks -%}
      {%- assign collection = collections[block.settings.collection] -%}
      {%- capture current_title -%}
        {%- if block.settings.title != blank -%}{{ block.settings.title }}{%- elsif collection != empty -%}{{ collection.title }}{%- else -%}{{ 'home_page.onboarding.collection_title' | t }}{%- endif -%}
      {%- endcapture -%}
      {%- assign current_title = current_title | downcase | strip -%}
      {%- if forloop.first -%}
        {%- assign first_title = current_title -%}
      {%- elsif current_title != first_title -%}
        {%- assign show_tabs = true -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if show_tabs -%}
      <div class="SectionHeader__TabList TabList" role="tablist">
        {%- for block in section.blocks -%}
          {%- assign collection = collections[block.settings.collection] -%}
          {%- capture tab_title -%}
            {%- if block.settings.title != blank -%}{{ block.settings.title }}{%- elsif collection != empty -%}{{ collection.title }}{%- else -%}{{ 'home_page.onboarding.collection_title' | t }}{%- endif -%}
          {%- endcapture -%}

          <button class="Heading u-h1 TabList__Item {% if forloop.first %}is-active{% endif %}" data-action="toggle-tab" aria-controls="block-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" role="tab">
            {{- tab_title -}}
          </button>
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- assign first_block = section.blocks[0] -%}
      {%- assign first_collection = collections[first_block.settings.collection] -%}
      {%- capture section_heading -%}
        {%- if first_block.settings.title != blank -%}{{ first_block.settings.title }}
        {%- elsif first_collection != empty -%}{{ first_collection.title }}
        {%- else -%}Best Sellers{%- endif -%}
      {%- endcapture -%}
      <h2 class="SectionHeader__Heading Heading u-h1" style="text-align:left !important;font-weight:500 !important;font-size:3em !important;font-family:'Playfair Display','Didot','Bodoni MT','Times New Roman',serif !important;letter-spacing:0.02em !important;text-transform:none !important;">{{ section_heading }}</h2>
      {%- if first_collection == empty -%}
      <p style="text-align:left;margin-top:6px;font-size:12px;letter-spacing:0.5px;">
        <span>spedizione rapida</span>
        <span style="margin:0 8px;opacity:0.4;">|</span>
        <span>Materiali premium</span>
        <span style="margin:0 8px;opacity:0.4;">|</span>
        <span>Design unico</span>
      </p>
      {%- endif -%}
    {%- endif -%}
  </header>

  {%- assign horizontal_spacing = 0 -%}
  {%- case settings.product_list_horizontal_spacing -%}
    {%- when 'extra_small' -%}{%- assign horizontal_spacing = 20 -%}
    {%- when 'small' -%}{%- assign horizontal_spacing = 40 -%}
    {%- when 'medium' -%}{%- assign horizontal_spacing = 60 -%}
    {%- when 'large' -%}{%- assign horizontal_spacing = 80 -%}
    {%- when 'extra_large' -%}{%- assign horizontal_spacing = 100 -%}
  {%- endcase -%}
  {%- assign half_spacing = horizontal_spacing | divided_by: 2 -%}
  {%- assign carousel_desktop_padding = 90 | plus: half_spacing -%}

  <style>
    [data-section-id="{{ section.id }}"] .SectionHeader--aligned {
      padding-left: 12px !important;
      padding-right: 12px !important;
    }
    [data-section-id="{{ section.id }}"].Section--carousel .SectionHeader--aligned {
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
    [data-section-id="{{ section.id }}"].Section--carousel .ProductItem__Wrapper--card {
      margin-left: 0 !important;
      margin-right: 0 !important;
    }
    @media screen and (max-width: 640px) {
      [data-section-id="{{ section.id }}"].Section--grid .SectionHeader--aligned {
        padding-left: 24px !important;
        padding-right: 24px !important;
      }
    }
    @media screen and (min-width: 641px) and (max-width: 1007px) {
      [data-section-id="{{ section.id }}"].Section--grid .SectionHeader--aligned {
        padding-left: 50px !important;
        padding-right: 50px !important;
      }
    }
    @media screen and (min-width: 1008px) {
      [data-section-id="{{ section.id }}"].Section--carousel .SectionHeader--aligned {
        padding-left: {{ carousel_desktop_padding }}px !important;
        padding-right: {{ carousel_desktop_padding }}px !important;
      }
      [data-section-id="{{ section.id }}"].Section--grid .SectionHeader--aligned {
        padding-left: 50px !important;
        padding-right: 50px !important;
      }
    }
  </style>

  {%- for block in section.blocks -%}
    {%- unless show_tabs or forloop.first -%}
      {%- continue -%}
    {%- endunless -%}

    {%- assign collection = collections[block.settings.collection] -%}

    {%- if collection == empty and block.settings.collection == blank -%}
      {%- assign collection = collections.all -%}
    {%- endif -%}

    <div class="TabPanel" id="block-{{ block.id }}" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}" role="tabpanel" {{ block.shopify_attributes }}>
      <div class="ProductListWrapper">
        {%- if collection != empty and collection.products_count > 0 -%}
          {%- assign item_count = block.settings.grid_items_count -%}

          {%- if collection.products_count < block.settings.grid_items_count -%}
            {%- assign item_count = collection.products_count -%}
          {%- endif -%}

          {%- if section.settings.layout_mode == 'grid' -%}
            <div class="ProductList ProductList--grid ProductList--removeMargin Grid" data-mobile-count="{{ section.settings.grid_mobile_items_per_row }}" data-desktop-count="4">
              {%- for product in collection.products limit: block.settings.grid_items_count -%}
                <div class="Grid__Cell 1/{{ section.settings.grid_mobile_items_per_row }}--phone 1/2--tablet 1/4--lap-and-up">
                  {%- include 'product-item', show_product_info: section.settings.show_product_info, show_color_swatch: section.settings.show_color_swatch, show_labels: true -%}
                </div>
              {%- endfor -%}
            </div>
          {%- else -%}
            <div class="ProductList ProductList--carousel Carousel" data-flickity-config='{{ flickity_options }}'>
              {%- for product in collection.products limit: block.settings.grid_items_count -%}
                <div class="Carousel__Cell">
                  {%- include 'product-item', show_product_info: section.settings.show_product_info, show_color_swatch: section.settings.show_color_swatch, show_labels: true -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- else -%}
          {%- comment -%}If collection is not set, we use placeholder content for all three layout mode{%- endcomment -%}

          {%- capture products_placeholder -%}
            {%- for i in (1..block.settings.grid_items_count) -%}
              <div class="{% if section.settings.layout_mode == 'grid' %}Grid__Cell 1/{{ section.settings.grid_mobile_items_per_row }}--phone 1/2--tablet-and-up 1/4--lap-and-up{% else %}Carousel__Cell{% endif %}">
                <div class="ProductItem">
                  <div class="ProductItem__Wrapper">

                    <a href="/collections/all" class="ProductItem__ImageWrapper">
                      {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                      {{ 'product-' | append: current | placeholder_svg_tag: 'ProductItem__Image PlaceholderSvg PlaceholderSvg--dark' }}
                    </a>

                    {%- if section.settings.show_product_info -%}
                      <div class="ProductItem__Info ProductItem__Info--{{ settings.product_info_alignment }}">
                        <h2 class="ProductItem__Title Heading">{{ 'home_page.onboarding.product_title' | t }}</h2>

                        <div class="ProductItem__PriceList Heading">
                          <span class="ProductItem__Price Price Text--subdued" data-money-convertible>{{ 3000 | money_without_trailing_zeros }}</span>
                        </div>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endcapture -%}

          {%- if section.settings.layout_mode == 'grid' -%}
            <div class="ProductList ProductList--grid ProductList--removeMargin Grid" data-mobile-count="{{ section.settings.grid_mobile_items_per_row }}" data-desktop-count="4">
              {{ products_placeholder }}
            </div>
          {%- else -%}
            <div class="ProductList ProductList--carousel Carousel" data-flickity-config='{{ flickity_options }}'>
              {{ products_placeholder }}
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- if block.settings.button_text != blank -%}
        <div class="Container">
          <div class="SectionFooter">
            <a href="{% if collection.url != blank %}{{ collection.url }}{% else %}/collections/all{% endif %}" class="Button Button--primary btn-silver-premium">{{ block.settings.button_text | escape }}</a>
          </div>
        </div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</section>

{%- capture hack -%}
{%- comment -%}This is just an ugly hack to make those variables appear as part of the theme editor in the General Settings{%- endcomment -%}
{% if section.settings.layout_mode == 'grid' %}{{ settings.product_list_horizontal_spacing }},{{ settings.product_list_vertical_spacing }}{% endif %}
{%- endcapture -%}

{% schema %}
{
  "name": "Featured collections",
  "class": "shopify-section--bordered",
  "max_blocks": 2,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Sub-heading",
      "default": "Featured collection"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "show_product_info",
      "label": "Show product info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_color_swatch",
      "label": "Show color swatch",
      "info": "Some colors appear white? [Learn more](http://support.maestrooo.com/article/80-product-uploading-custom-color-for-color-swatch).",
      "default": false
    },
    {
      "type": "header",
      "content": "Grid",
      "info": "Those settings apply only if the layout mode is set to grid."
    },
    {
      "type": "select",
      "id": "grid_mobile_items_per_row",
      "label": "Products per row (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "min": 2,
      "max": 4,
      "id": "grid_desktop_items_per_row",
      "label": "Products per row (desktop)",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "info": "If none is set, collection title is used."
        },
        {
          "type": "range",
          "id": "grid_items_count",
          "min": 2,
          "max": 50,
          "step": 1,
          "label": "Products to show",
          "default": 8
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "View all products"
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "Collection",
      "name": "Featured collections",
      "settings": {},
      "blocks": [
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}