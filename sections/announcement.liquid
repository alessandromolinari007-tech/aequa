{%- if section.settings.enable_bar -%}
  {%- unless section.settings.home_page_only and template != 'index' -%}
    <section id="section-{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="announcement-bar">
      <div class="AnnouncementBar">
        <div class="AnnouncementBar__Wrapper">
          <p class="AnnouncementBar__Content Heading">
            {%- if section.settings.link -%}
              <a href="{{ section.settings.link }}">{{ section.settings.content | escape }}</a>
            {%- else -%}
              {{ section.settings.content | escape }}
            {%- endif -%}
          </p>
        </div>
      </div>
    </section>

    <script>(function(){var s=document.getElementById('section-{{ section.id }}');if(s){document.documentElement.style.setProperty('--announcement-bar-height',s.offsetHeight+'px')}})();</script>
    <style>#section-{{ section.id }} .AnnouncementBar__Wrapper{padding-top:6px!important;padding-bottom:6px!important}#section-{{ section.id }} .AnnouncementBar{font-size:10px!important}</style>
  {%- endunless -%}
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_bar",
      "label": "Enable bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "home_page_only",
      "label": "Home page only",
      "default": false
    },
    {
      "type": "text",
      "id": "content",
      "label": "Text",
      "default": "Consegna in 10 giorni"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ]
}
{% endschema %}