{%- capture flickity_options -%}{"prevNextButtons":false,"setGallerySize":{% if section.settings.show_fullscreen %}false{% else %}true{% endif %},"adaptiveHeight":{% if section.settings.show_fullscreen %}false{% else %}true{% endif %},"wrapAround":{% if section.blocks.size > 1 %}true{% else %}false{% endif %},"dragThreshold":{% if section.blocks.size > 1 %}15{% else %}false{% endif %},"draggable":{% if section.blocks.size > 1 %}true{% else %}false{% endif %},"pauseAutoPlayOnHover":false,"autoPlay":{% if section.blocks.size > 1 and section.settings.autoplay %}{{ section.settings.cycle_speed | times: 1000 }}{% else %}false{% endif %},"pageDots":false}{%- endcapture -%}

<section id="section-{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="slideshow">
  {%- assign has_video = false -%}
{%- for block in section.blocks -%}{%- if block.settings.video_mp4 != blank -%}{%- assign has_video = true -%}{%- endif -%}{%- endfor -%}
<style>
  @media screen and (max-width: 640px) {
    #section-{{ section.id }} .Slideshow__ImageContainer {
      height: 100vh !important;
      min-height: 100vh !important;
      max-height: 100vh !important;
      position: relative !important;
      overflow: hidden !important;
      width: 100vw !important;
      padding-bottom: 0 !important;
    }
    #section-{{ section.id }} .Slideshow__ImageContainer::before {
      content: none !important;
      display: none !important;
      padding-bottom: 0 !important;
    }
    #section-{{ section.id }} .Slideshow__Image {
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: center !important;
      opacity: 1 !important;
      visibility: visible !important;
      display: block !important;
    }
    #section-{{ section.id }} .Slideshow__Slide,
    #section-{{ section.id }} .Slideshow__Carousel,
    #section-{{ section.id }} .flickity-viewport,
    #section-{{ section.id }} .flickity-slider {
      height: 100vh !important;
      min-height: 100vh !important;
      max-height: 100vh !important;
    }
  }

  /* AEQUO: dark overlay + white text for video slides */
  #section-{{ section.id }} .Slideshow__Slide--hasVideo {
    position: relative;
  }

  #section-{{ section.id }} .Slideshow__Slide--hasVideo::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.45);
    z-index: 1;
    pointer-events: none;
  }

  #section-{{ section.id }} .Slideshow__Slide--hasVideo .Slideshow__Content {
    z-index: 2;
  }

  #section-{{ section.id }} .Slideshow__Slide--hasVideo .SectionHeader__Heading,
  #section-{{ section.id }} .Slideshow__Slide--hasVideo .SectionHeader__SubHeading,
  #section-{{ section.id }} .Slideshow__Slide--hasVideo .SectionHeader__ButtonWrapper .Button {
    color: #ffffff !important;
    text-shadow: 0px 2px 10px rgba(0, 0, 0, 0.3) !important;
  }
</style>
<div class="Slideshow {% if section.settings.show_fullscreen %}Slideshow--fullscreen{% endif %}{% if has_video %} Slideshow--hasVideo{% endif %}">
    <div class="Slideshow__Carousel {% if section.settings.show_arrow %}Slideshow__Carousel--withScrollButton{% endif %} Carousel Carousel--fadeIn {% if section.settings.show_fullscreen %}Carousel--fixed{% endif %} Carousel--insideDots"
         data-flickity-config='{{ flickity_options }}'>
      {%- for block in section.blocks -%}
        {%- if forloop.first and block.settings.image -%}
          <link rel="preload" as="image" href="{{ block.settings.image | img_url: '1600x' }}" imagesrcset="{{ block.settings.image | img_url: '400x' }} 400w, {{ block.settings.image | img_url: '800x' }} 800w, {{ block.settings.image | img_url: '1200x' }} 1200w, {{ block.settings.image | img_url: '1600x' }} 1600w, {{ block.settings.image | img_url: '2000x' }} 2000w" imagesizes="100vw">
        {%- endif -%}
        <div id="Slide{{ block.id }}" class="Slideshow__Slide Carousel__Cell {% if forloop.first %}is-selected{% endif %}{% if block.settings.video_mp4 != blank %} Slideshow__Slide--hasVideo{% endif %}" {% if forloop.first %}style="visibility: visible"{% endif %} data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- comment -%}
            Implementation note: this is an art driven image selection so it would have been better to be able to use the "picture" tag instead. However,
            as the mobile and desktop image could have different aspect ratio, the image allocation space would not have work properly without explicitly
            distinguishing the two images, hence the two containers.
          {%- endcomment -%}

          {%- assign mobile_image = block.settings.mobile_image | default: block.settings.image -%}

          {%- if mobile_image or block.settings.video_mp4 != blank -%}
            <div class="Slideshow__ImageContainer {% if block.settings.apply_overlay and block.settings.video_mp4 == blank %}Image--contrast{% endif %} {% unless section.settings.show_fullscreen %}AspectRatio{% endunless %} hidden-tablet-and-up"
                 style="{% unless section.settings.show_fullscreen %}--aspect-ratio: {{ mobile_image.aspect_ratio | default: 1.777 }};{% endunless %}{% if mobile_image and block.settings.video_mp4 == blank %} background-image: url({{ mobile_image | img_url: '1x1', format: 'jpg' }}){% endif %}">
              {%- if block.settings.video_mp4 != blank -%}
                <video class="Slideshow__Image" src="{{ block.settings.video_mp4 }}" autoplay muted loop playsinline poster="{{ mobile_image | img_url: '800x' }}" {% unless forloop.first %}preload="none"{% endunless %}></video>
              {%- else -%}
                {%- if forloop.first -%}
                  <img class="Slideshow__Image"
                       loading="eager"
                       fetchpriority="high"
                       decoding="async"
                       src="{{ mobile_image | img_url: 'x800' }}"
                       srcset="{{ mobile_image | img_url: '400x' }} 400w, {{ mobile_image | img_url: '600x' }} 600w, {{ mobile_image | img_url: '800x' }} 800w"
                       sizes="100vw"
                       width="{{ mobile_image.width }}"
                       height="{{ mobile_image.height }}"
                       alt="{{ mobile_image.alt | escape }}">
                {%- else -%}
                  <img class="Slideshow__Image Image--lazyLoad"
                       src="{{ mobile_image | img_url: '1x1' }}"
                       data-src="{{ mobile_image | img_url: 'x800' }}"
                       width="{{ mobile_image.width }}"
                       height="{{ mobile_image.height }}"
                       decoding="async"
                       fetchpriority="low"
                       alt="{{ mobile_image.alt | escape }}" loading="lazy">
                {%- endif -%}

                <noscript>
                  <img class="Slideshow__Image" src="{{ mobile_image | img_url: 'x800' }}" width="{{ mobile_image.width }}" height="{{ mobile_image.height }}" alt="{{ mobile_image.alt | escape }}">
                </noscript>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if block.settings.image or block.settings.video_mp4 != blank -%}
            <div class="Slideshow__ImageContainer {% if block.settings.apply_overlay and block.settings.video_mp4 == blank %}Image--contrast{% endif %} {% unless section.settings.show_fullscreen %}AspectRatio{% endunless %} hidden-phone"
                 style="{% unless section.settings.show_fullscreen %}--aspect-ratio: {{ block.settings.image.aspect_ratio | default: 1.777 }};{% endunless %}{% if block.settings.image and block.settings.video_mp4 == blank %} background-image: url({{ block.settings.image | img_url: '1x1', format: 'jpg' }}){% endif %}">
              {%- if block.settings.video_mp4 != blank -%}
                <video class="Slideshow__Image" src="{{ block.settings.video_mp4 }}" autoplay muted loop playsinline poster="{{ block.settings.image | img_url: '1600x' }}" {% unless forloop.first %}preload="none"{% endunless %}></video>
              {%- else -%}
                {%- if forloop.first -%}
                  <img class="Slideshow__Image hide-no-js"
                       loading="eager"
                       fetchpriority="high"
                       decoding="async"
                       src="{{ block.settings.image | img_url: '1600x' }}"
                       srcset="{{ block.settings.image | img_url: '400x' }} 400w, {{ block.settings.image | img_url: '800x' }} 800w, {{ block.settings.image | img_url: '1200x' }} 1200w, {{ block.settings.image | img_url: '1600x' }} 1600w, {{ block.settings.image | img_url: '2000x' }} 2000w"
                       sizes="100vw"
                       alt="{{ block.settings.image.alt | escape }}">
                {%- else -%}
                  {% assign image_url = block.settings.image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}

                  <img class="Slideshow__Image Image--lazyLoad hide-no-js"
                       data-src="{{ image_url }}"
                       data-optimumx="1.2"
                       data-widths="[400, 600, 800, 1000, 1200, 1400, 1600, 1800]"
                       data-sizes="auto"
                       alt="{{ block.settings.image.alt | escape }}"
                       fetchpriority="low" loading="lazy">
                {%- endif -%}

                <noscript>
                  <img class="Slideshow__Image" src="{{ block.settings.image | img_url: '1000x' }}" alt="{{ block.settings.image.alt | escape }}">
                </noscript>
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="Slideshow__ImageContainer {% if block.settings.apply_overlay %}Image--contrast{% endif %} {% if section.settings.show_fullscreen %}PlaceholderBackground{% endif %} PlaceholderSvg--dark">
              {%- capture placeholder -%}{% cycle 'lifestyle-1', 'lifestyle-2' %}{%- endcapture -%}
              {{ placeholder | placeholder_svg_tag: 'Slideshow__Image PlaceholderBackground__Svg' }}
            </div>
          {%- endif -%}

          <div class="Slideshow__Content Slideshow__Content--{{ block.settings.content_position | default: 'middleCenter' }}">
            {%- if block.settings.subheading != blank or block.settings.title != blank -%}
              <header class="SectionHeader">
                {%- if block.settings.title != blank -%}
                  <h2 class="SectionHeader__Heading SectionHeader__Heading--emphasize Heading u-h1">{{ block.settings.title | escape }}</h2>
                {%- endif -%}

                {%- if block.settings.subheading != blank -%}
                  <h3 class="SectionHeader__SubHeading Heading u-h6">{{ block.settings.subheading | escape }}</h3>
                {%- endif -%}

                {%- if block.settings.button_1_text != blank and block.settings.button_2_text != blank -%}
                  {%- assign has_two_buttons = true -%}
                {%- else -%}
                  {%- assign has_two_buttons = false -%}
                {%- endif -%}

                {%- if block.settings.button_1_text != blank or block.settings.button_2_text != blank -%}
                  <div class="SectionHeader__ButtonWrapper">
                    <div class="ButtonGroup ButtonGroup--spacingSmall {% if has_two_buttons %}ButtonGroup--sameSize{% endif %}">
                      {%- if block.settings.button_1_text != blank -%}
                        <a href="{{ block.settings.button_1_link }}" class="ButtonGroup__Item Button">{{ block.settings.button_1_text | escape }}</a>
                      {%- endif -%}

                      {%- if block.settings.button_2_text != blank -%}
                        <a href="{{ block.settings.button_2_link }}" class="Slideshow__Button ButtonGroup__Item Button">{{ block.settings.button_2_text | escape }}</a>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              </header>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_arrow -%}
      <button type="button" data-href="#section-{{ section.id }}-end" class="Slideshow__ScrollButton RoundButton RoundButton--medium" data-animate-bottom>
        {%- include 'icon' with 'arrow-bottom' -%}
      </button>
    {%- endif -%}
  </div>

  <span id="section-{{ section.id }}-end" class="Anchor"></span>
</section>


{% schema %}
{
  "name": "Slideshow",
  "class": "shopify-section--slideshow",
  "max_blocks": 5,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_fullscreen",
      "label": "Show full-screen images",
      "info": "If enabled, images will be resized to fit the entire screen.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show bottom arrow",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto rotate between slides",
      "default": true
    },
    {
      "type": "range",
      "id": "cycle_speed",
      "min": 3,
      "max": 8,
      "step": 1,
      "unit": "sec",
      "label": "Change slides every",
      "default": 5
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button text",
      "default": "#111111"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "1560 x 1050px jpg recommended"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "750 x 1100px jpg recommended. If none is set, desktop image will be cropped."
        },
        {
          "type": "text",
          "id": "video_mp4",
          "label": "Video MP4 URL",
          "info": "Incolla l'URL di un file MP4 caricato su Shopify (Contenuto > Files). Se impostato, sostituirà l'immagine."
        },
        {
          "type": "checkbox",
          "id": "apply_overlay",
          "label": "Apply overlay on image",
          "info": "This can improve text visibility.",
          "default": true
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Desktop content position",
          "options": [
            {
              "value": "middleLeft",
              "label": "Middle left"
            },
            {
              "value": "middleCenter",
              "label": "Middle center"
            },
            {
              "value": "bottomLeft",
              "label": "Bottom left"
            },
            {
              "value": "bottomCenter",
              "label": "Bottom center"
            }
          ],
          "default": "middleCenter"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Sub-heading",
          "default": "Slide title"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Racconta la tua storia"
        },
        {
          "type": "header",
          "content": "Button 1"
        },
        {
          "type": "text",
          "id": "button_1_text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Button 2"
        },
        {
          "type": "text",
          "id": "button_2_text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "Image",
      "name": "Slideshow",
      "settings": {},
      "blocks": [
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}