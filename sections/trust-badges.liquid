<section class="Section TrustBadges" data-section-id="{{ section.id }}" data-section-type="trust-badges">
  <div class="Container">
    <div class="TrustBadges__Grid">
      {%- for block in section.blocks -%}
        <div class="TrustBadges__Item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <div class="TrustBadges__IconWrapper">
              <img src="{{ block.settings.icon | img_url: '100x' }}" alt="{{ block.settings.title | escape }}" class="TrustBadges__Icon" width="40" height="40">
            </div>
          {%- else -%}
            <div class="TrustBadges__IconWrapper">
              <svg class="TrustBadges__Icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="40" height="40">
                {%- if forloop.index == 1 -%}
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                {%- elsif forloop.index == 2 -%}
                  <polyline points="20 6 9 17 4 12"/>
                {%- elsif forloop.index == 3 -%}
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                {%- else -%}
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                {%- endif -%}
              </svg>
            </div>
          {%- endif -%}

          <div class="TrustBadges__Content">
            {%- if block.settings.title != blank -%}
              <h4 class="TrustBadges__Title Heading u-h7">{{ block.settings.title | escape }}</h4>
            {%- endif -%}
            {%- if block.settings.subtitle != blank -%}
              <p class="TrustBadges__Subtitle">{{ block.settings.subtitle | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>.TrustBadges{padding:40px 0;border-top:1px solid rgba(0,0,0,.06);border-bottom:1px solid rgba(0,0,0,.06);background:#fff}.TrustBadges__Grid{display:flex;flex-wrap:wrap;justify-content:center;align-items:stretch;gap:0}.TrustBadges__Item{display:flex;align-items:center;gap:16px;padding:20px 32px;flex:1 1 auto;justify-content:center;cursor:default}.TrustBadges__Item:not(:last-child){border-right:none}.TrustBadges__IconWrapper{flex-shrink:0;width:56px;height:56px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#F5F5F5;color:#111;transition:transform .35s cubic-bezier(.34,1.56,.64,1),background-color .3s ease,box-shadow .3s ease}.TrustBadges__IconWrapper svg,.TrustBadges__IconWrapper img{transition:transform .35s cubic-bezier(.34,1.56,.64,1)}.TrustBadges__Item:hover .TrustBadges__IconWrapper{transform:scale(1.15);background:#F2C94C;color:#111;box-shadow:0 4px 14px rgba(242,201,76,.35)}.TrustBadges__Item:hover .TrustBadges__IconWrapper svg,.TrustBadges__Item:hover .TrustBadges__IconWrapper img{transform:scale(1.1)}.TrustBadges__Icon{width:22px;height:22px;object-fit:contain;display:block}.TrustBadges__Content{text-align:left}.TrustBadges__Title{margin:0 0 3px;font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#111}.TrustBadges__Subtitle{margin:0;font-size:12px;color:#999;line-height:1.4}@media(max-width:767px){.TrustBadges__Grid{flex-direction:column;gap:0}.TrustBadges__Item{width:100%;justify-content:flex-start;padding:14px 20px;border-right:none!important;border-bottom:none}}</style>

{% schema %}
{
  "name": "Trust badges",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "40x40px PNG/SVG recommended"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Spedizione Veloce"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Consegna in 10 giorni"
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "Content",
      "name": "Trust badges",
      "blocks": {
        "badge-0": {
          "type": "badge",
          "settings": {
            "title": "Spedizione Veloce",
            "subtitle": "Consegna in 10 giorni"
          }
        },
        "badge-1": {
          "type": "badge",
          "settings": {
            "title": "Qualita Garantita",
            "subtitle": "Materiali premium selezionati"
          }
        },
        "badge-2": {
          "type": "badge",
          "settings": {
            "title": "Acquisto Sicuro",
            "subtitle": "Pagamenti protetti al 100%"
          }
        },
        "badge-3": {
          "type": "badge",
          "settings": {
            "title": "Supporto Clienti",
            "subtitle": "Assistenza 7 giorni su 7"
          }
        }
      },
      "block_order": [
        "badge-0",
        "badge-1",
        "badge-2",
        "badge-3"
      ]
    }
  ]
}
{% endschema %}
