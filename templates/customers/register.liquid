<section class="AccountPage AccountPage--register" data-section-id="register" data-section-type="register">
  <div class="Container">
    <div class="AccountPage__Wrapper">
      {%- form 'create_customer', name: 'create_customer', class: 'AccountPage__Form', id: 'create_customer' -%}
        <h1 class="AccountPage__Heading Heading">{{ 'customer.register.title' | t }}</h1>
        <p class="AccountPage__Subheading">Unisciti ad AEQUO</p>

        {%- if form.errors -%}
          <div class="AccountPage__Error">
            {%- for field in form.errors -%}
              {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}
              {%- else -%}
                <strong>{{ form.errors.translated_fields[field] }}</strong> {{ form.errors.messages[field] }}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="AccountPage__Field">
          <input type="text" class="AccountPage__Input" name="customer[first_name]" placeholder="Nome" aria-label="Nome" autofocus>
        </div>

        <div class="AccountPage__Field">
          <input type="text" class="AccountPage__Input" name="customer[last_name]" placeholder="Cognome" aria-label="Cognome">
        </div>

        <div class="AccountPage__Field">
          <input type="email" class="AccountPage__Input" name="customer[email]" placeholder="Email" aria-label="Email" required>
        </div>

        <div class="AccountPage__Field">
          <input type="password" class="AccountPage__Input" name="customer[password]" placeholder="Password" aria-label="Password" required>
        </div>

        <button type="submit" class="AccountPage__Submit">REGISTRATI</button>

        <div class="AccountPage__Divider">
          <span>oppure</span>
        </div>

        <a href="/account/login" class="AccountPage__OutlineButton">HAI GIÀ UN ACCOUNT? ACCEDI</a>
      {%- endform -%}
    </div>
  </div>
</section>