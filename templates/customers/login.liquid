<section class="AccountPage AccountPage--login" data-section-id="login" data-section-type="login">
  <div class="Container">
    <div class="AccountPage__Wrapper">
      {%- assign is_recover_active = false -%}

      {%- form 'recover_customer_password' -%}
        {%- if form.errors or form.posted_successfully? -%}
          {%- assign is_recover_active = true -%}
        {%- endif -%}
      {%- endform -%}

      {%- if is_recover_active -%}
        {%- assign login_default_visibility = 'display: none' -%}
      {%- else -%}
        {%- assign login_default_visibility = 'display: block' -%}
      {%- endif -%}

      <!-- LOGIN -->
      {%- form 'customer_login', name: 'login', class: 'AccountPage__Form', id: 'customer_login', style: login_default_visibility -%}
        <h1 class="AccountPage__Heading Heading">{{ 'customer.login.title' | t }}</h1>
        <p class="AccountPage__Subheading">Accedi al tuo account AEQUO</p>

        {%- if form.errors -%}
          <div class="AccountPage__Error">{{ form.errors.messages['form'] }}</div>
        {%- endif -%}

        <div class="AccountPage__Field">
          <input type="email" class="AccountPage__Input" name="customer[email]" required placeholder="Email" aria-label="Email" autofocus>
        </div>

        <div class="AccountPage__Field">
          <input type="password" class="AccountPage__Input" name="customer[password]" required placeholder="Password" aria-label="Password">
        </div>

        <button type="button" class="AccountPage__Link AccountPage__Link--right" data-action="toggle-recover-form">Password dimenticata?</button>

        <button type="submit" class="AccountPage__Submit">ACCEDI</button>

        <div class="AccountPage__Divider">
          <span>oppure</span>
        </div>

        <a href="/account/register" class="AccountPage__OutlineButton">CREA UN ACCOUNT</a>
      {%- endform -%}

      <!-- RECOVER -->
      {%- if is_recover_active -%}
        {%- assign recover_default_visibility = 'display: block' -%}
      {%- else -%}
        {%- assign recover_default_visibility = 'display: none' -%}
      {%- endif -%}

      {%- form 'recover_customer_password', name: 'recover', class: 'AccountPage__Form', id: 'recover_customer_password', style: recover_default_visibility -%}
        <h1 class="AccountPage__Heading Heading">{{ 'customer.recover_password.title' | t }}</h1>
        <p class="AccountPage__Subheading">{{ 'customer.recover_password.description' | t }}</p>

        {%- if form.errors -%}
          <div class="AccountPage__Error">{{ form.errors.messages['form'] }}</div>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <div class="AccountPage__Success">{{ 'customer.recover_password.success' | t }}</div>
        {%- endif -%}

        <div class="AccountPage__Field">
          <input type="email" class="AccountPage__Input" name="email" required placeholder="Email" aria-label="Email" autofocus>
        </div>

        <button type="submit" class="AccountPage__Submit">INVIA</button>

        <button type="button" class="AccountPage__Link AccountPage__Link--center" data-action="toggle-recover-form">Torna al login</button>
      {%- endform -%}
    </div>
  </div>
</section>